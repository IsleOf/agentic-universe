    {
      "id": "principle_affordance_over_constraint",
      "label": "Affordance over constraint",
      "type": "principle",
      "status": "stable_theory",
      "approach_family": "emergent_behaviors",
      "branch_key": "emergent_behaviors:affordance_first",
      "confidence": 0.6,
      "description": "Give agents capability, context, and room; observe what they do with it; build structure around the behaviour that proves useful. The inverse of specifying behaviour up front and treating deviation as failure. A constraint added before the behaviour is understood forecloses the observation that would justify it.",
      "tags": [
        "design-principle",
        "affordance",
        "autonomy",
        "emergence",
        "observation-first"
      ]
    },
