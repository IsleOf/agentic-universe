    {
      "id": "finding_prefix_executability_20261029",
      "label": "Prefix executability reveals invalid tool trajectories hidden by final success",
      "type": "evaluation_result",
      "status": "to_test",
      "verification_state": "needs_empirical_validation",
      "approach_family": "orchestration_first",
      "confidence": 0.66,
      "description": "A trajectory-level protocol checks whether each tool-call prefix remains executable under schemas, preconditions, and data dependencies; the authors report ranking disagreements with final-success metrics and improved prefix survival from plan checking. Research claim; not independently reproduced here.",
      "tags": [
        "agent-evaluation",
        "tool-use",
        "trajectory",
        "verification",
        "recovery"
      ],
      "derived_from": [
        "arXiv:2610.40444, submitted 2026-10-29; abstract reviewed 2026-10-31"
